# Optional Stage 5 provider credential. The default pipeline does not use it.
# The code reads this variable only when AI is explicitly enabled/configured.
VIREO_AI_API_KEY=

# Optional dashboard bundle directory; relative paths resolve from the project root.
# For container deployment this is /app/runtime-data (mounted read-only).
VIREO_INTERIM_DIR=data/interim

# Optional Python logging threshold: DEBUG, INFO, WARNING, ERROR, CRITICAL.
VIREO_LOG_LEVEL=INFO
